<?xml version="1.0" encoding="utf-8"?>
<!--
    A single dot on a dot grid: the app's own icon, built from the same visual
    language the dot-matrix clock uses. Deliberately simple — the real dot
    renderer is Compose code in M5, and an icon has to survive being scaled
    down to 48dp and masked to a circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 3x3 dot matrix, centred in the 72dp safe zone. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,50m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,62m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,62m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,74m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
</vector>
